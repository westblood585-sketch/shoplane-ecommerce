{
  "name": "MyShop - E-Ticaret Platformu",
  "short_name": "MyShop",
  "description": "Modern e-ticaret platformu. 570+ ürün, PWA, karanlık mod, offline destek ve çok daha fazlası.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ffffff",
  "theme_color": "#1e40af",
  "screenshots": [
    {
      "src": "/screenshots/screenshot-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshots/screenshot-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "wide"
    }
  ],
  "icons": [
    {
      "src": "/favicon-16x16.svg",
      "sizes": "16x16",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/favicon-32x32.svg",
      "sizes": "32x32",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.svg",
      "sizes": "180x180",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/og-image.svg",
      "sizes": "1200x630",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "categories": ["shopping", "lifestyle"],
  "screenshots": [
    {
      "src": "/screenshots/screenshot1.png",
      "sizes": "540x720",
      "form_factor": "narrow"
    },
    {
      "src": "/screenshots/screenshot2.png",
      "sizes": "1280x720",
      "form_factor": "wide"
    }
  ],
  "shortcuts": [
    {
      "name": "Ürünleri Gözat",
      "short_name": "Ürünler",
      "description": "Tüm ürünleri görüntüleyin",
      "url": "/products",
      "icons": [{ "src": "/shortcut-products.png", "sizes": "192x192" }]
    },
    {
      "name": "Sepetim",
      "short_name": "Sepet",
      "description": "Alışveriş sepetinizi görüntüleyin",
      "url": "/cart",
      "icons": [{ "src": "/shortcut-cart.png", "sizes": "192x192" }]
    },
    {
      "name": "Favorilerim",
      "short_name": "Favoriler",
      "description": "İstek listenizi görüntüleyin",
      "url": "/favorites",
      "icons": [{ "src": "/shortcut-favorites.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
