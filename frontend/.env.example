# Frontend Environment Variables Example
# Development ortamında: .env dosyası (uses Vite proxy)
# Production ortamında: .env.production dosyası

# API Base URL
# Development: Use /api to proxy through Vite (see vite.config.js)
# Production: Use full URL like https://api.yourdomain.com/api
VITE_API_URL=/api

# App Settings
VITE_APP_NAME=MyShop
VITE_APP_VERSION=1.0.0
VITE_LOG_LEVEL=debug

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GAMIFICATION=true
VITE_LOG_LEVEL=debug

# Analytics (Google Analytics ID)
VITE_GA_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_PWA=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_GAMIFICATION=true
