const express = require('express')
const dotenv = require('dotenv')
const cors = require('cors')
const cookieParser = require('cookie-parser')
const connectDB = require('./config/database')
const errorHandler = require('./middleware/errorHandler')

dotenv.config()
connectDB()

const app = express()

// Middleware
app.use(express.json())
app.use(express.urlencoded({ extended: true }))
app.use(cookieParser())
app.use(cors({
  origin: process.env.CLIENT_URL || 'http://localhost:5173',
  credentials: true
}))

// Routes - TEMEL ROUTE'LAR
app.use('/api/auth', require('./routes/authRoutes'))
app.use('/api/products', require('./routes/productRoutes'))
app.use('/api/orders', require('./routes/orderRoutes'))
app.use('/api/addresses', require('./routes/addressRoutes'))

// Review routes (nested)
const reviewRoutes = require('./routes/reviewRoutes')
app.use('/api/products/:productId/reviews', reviewRoutes)

// Opsiyonel routes - hata verse bile server çalışsın
try {
  app.use('/api/payment', require('./routes/paymentRoutes'))
  console.log('✅ Payment routes loaded')
} catch (error) {
  console.log('⚠️  Payment routes not loaded:', error.message)
}

try {
  app.use('/api/analytics', require('./routes/analyticsRoutes'))
  console.log('✅ Analytics routes loaded')
} catch (error) {
  console.log('⚠️  Analytics routes not loaded:', error.message)
}

try {
  app.use('/api/chat', require('./routes/chatRoutes'))
  console.log('✅ Chat routes loaded')
} catch (error) {
  console.log('⚠️  Chat routes not loaded:', error.message)
}

try {
  app.use('/api/favorites', require('./routes/favoriteRoutes'))
  console.log('✅ Favorites routes loaded')
} catch (error) {
  console.log('⚠️  Favorites routes not loaded:', error.message)
}

// Test endpoint
app.get('/', (req, res) => {
  res.json({
    success: true,
    message: 'E-ticaret API çalışıyor! 🚀',
    version: '1.0.0'
  })
})

// 404 handler
app.use((req, res) => {
  res.status(404).json({
    success: false,
    message: 'Endpoint bulunamadı'
  })
})

// Error handler
app.use(errorHandler)

const PORT = process.env.PORT || 5001

app.listen(PORT, () => {
  console.log(`
  ╔═══════════════════════════════════════╗
  ║   🚀 Server çalışıyor!                ║
  ║   📍 Port: ${PORT}                      ║
  ║   🌍 Mode: ${process.env.NODE_ENV}    ║
  ╚═══════════════════════════════════════╝
  `)
})

process.on('unhandledRejection', (err) => {
  console.error(`❌ Error: ${err.message}`)
})