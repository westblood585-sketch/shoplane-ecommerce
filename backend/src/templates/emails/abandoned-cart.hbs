<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sepetinde Ürünler Var</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Arial', sans-serif;
            background-color: #f5f5f5;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
        }
        .header {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            color: #ffffff;
            margin: 0;
            font-size: 32px;
        }
        .content {
            padding: 40px 30px;
        }
        .cart-icon {
            text-align: center;
            font-size: 80px;
            margin: 20px 0;
        }
        .discount-banner {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            text-align: center;
            padding: 25px;
            border-radius: 12px;
            margin: 30px 0;
        }
        .discount-banner h2 {
            margin: 0 0 10px 0;
            font-size: 28px;
        }
        .discount-code {
            background-color: #ffffff;
            color: #f59e0b;
            font-size: 24px;
            font-weight: bold;
            padding: 15px 30px;
            border-radius: 8px;
            display: inline-block;
            margin: 10px 0;
            letter-spacing: 2px;
        }
        .product-item {
            display: flex;
            padding: 15px;
            background-color: #f9fafb;
            border-radius: 8px;
            margin: 10px 0;
        }
        .product-image {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border-radius: 6px;
            margin-right: 15px;
        }
        .product-info {
            flex: 1;
        }
        .button {
            display: inline-block;
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            text-decoration: none;
            padding: 15px 40px;
            border-radius: 8px;
            font-weight: bold;
            margin: 20px 0;
            font-size: 16px;
        }
        .urgency {
            background-color: #fef3c7;
            border-left: 4px solid #f59e0b;
            padding: 15px;
            margin: 20px 0;
            color: #92400e;
        }
        .footer {
            background-color: #f9f9f9;
            padding: 30px;
            text-align: center;
            color: #999999;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>🛒 Sepetinde Ürünler Var!</h1>
        </div>

        <!-- Content -->
        <div class="content">
            <div class="cart-icon">🛍️</div>
            
            <h2 style="text-align: center;">Merhaba {{name}}! 👋</h2>
            <p style="text-align: center; font-size: 18px; color: #666666;">
                Sepetinde unutulmuş ürünler var. Onları özledik! 😊
            </p>

            <!-- Products -->
            {{#each items}}
            <div class="product-item">
                <img src="{{product.images.0}}" alt="{{product.name}}" class="product-image">
                <div class="product-info">
                    <p style="font-weight: bold; margin: 0; color: #333333;">{{product.name}}</p>
                    <p style="color: #f59e0b; font-weight: bold; margin: 5px 0;">{{product.price}}₺</p>
                </div>
            </div>
            {{/each}}

            <!-- Discount Banner -->
            <div class="discount-banner">
                <h2>🎁 SANA ÖZEL HEDİYE!</h2>
                <p style="margin: 10px 0;">Sepetini tamamla, sana özel indirimini kazan!</p>
                <div class="discount-code">{{discountCode}}</div>
                <p style="margin: 10px 0; font-size: 18px;">%{{discountAmount}} İNDİRİM</p>
            </div>

            <!-- Urgency -->
            <div class="urgency">
                <strong>⏰ Acele Et!</strong> Sepetindeki ürünler stoktan tükenebilir. 
                Bu özel indirim sadece 24 saat geçerli!
            </div>

            <p style="text-align: center;">
                <a href="{{cartUrl}}" class="button">Sepetime Dön</a>
            </p>

            <p style="text-align: center; color: #999999; font-size: 14px;">
                Toplam Tutar: <strong style="color: #333333;">{{totalPrice}}₺</strong>
            </p>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>Bu e-postayı almak istemiyor musun?</p>
            <p><a href="{{websiteUrl}}/unsubscribe" style="color: #999999;">E-posta bildirimlerinden çık</a></p>
            <p>© 2026 MyShop. Tüm hakları saklıdır.</p>
        </div>
    </div>
</body>
</html>