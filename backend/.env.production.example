# BACKEND PRODUCTION ENVIRONMENT
# Copy to .env.production and fill with real values before deploying

NODE_ENV=production
PORT=5001

# DATABASE - Use MongoDB Atlas
MONGODB_URI=mongodb+srv://eticaret_admin:your_password@cluster.mongodb.net/eticaret?retryWrites=true&w=majority

# PRODUCTION URLS - ⚠️ CHANGE THESE TO YOUR DOMAIN!
FRONTEND_URL=https://yourdomain.com
BASE_URL=https://yourdomain.com

# JWT - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate_a_random_key_here_at_least_32_chars_long
JWT_EXPIRE=7d

# Email (optional - using Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Iyzico Payment Gateway
IYZICO_API_KEY=your_production_api_key
IYZICO_API_SECRET=your_production_api_secret
IYZICO_BASE_URL=https://api.iyzipay.com

# Logging
LOG_LEVEL=info

# Security
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT=100
