# Backend Environment Variables Example
# ASLA bu dosyayı commit'leme! .gitignore'da var.
# Development için bu dosyanın adını .env olarak değiştir.

# Environment
NODE_ENV=development

# Server
PORT=5001

# Database
MONGODB_URI=mongodb://localhost:27017/myshop

# JWT
JWT_SECRET=your-secret-key-minimum-32-characters-for-production
JWT_COOKIE_EXPIRE=7

# Client URL
CLIENT_URL=http://localhost:5173

# Email Configuration (Gmail örneği)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_FROM_NAME=MyShop
SMTP_FROM_EMAIL=noreply@myshop.com

# Payment Gateway (Iyzico)
IYZICO_API_KEY=your-api-key
IYZICO_SECRET_KEY=your-secret-key
IYZICO_BASE_URL=https://api.sandbox.iyzipay.com

# Redis (Opsiyonel)
# REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
